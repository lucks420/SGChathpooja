<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 800" width="100%" height="100%">
  <defs>
    <filter id="softShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#475569" flood-opacity="0.08" />
    </filter>
  </defs>

  <!-- Container background (Light App Theme) -->
  <rect width="540" height="800" rx="24" fill="#F3F6FA" />

  <!-- Main White QR Card -->
  <rect x="30" y="110" width="480" height="570" rx="28" fill="#FFFFFF" filter="url(#softShadow)" />

  <!-- Top Header Profile: R Circle & RAHUL YADAV -->
  <g transform="translate(55, 42)">
    <circle cx="24" cy="24" r="24" fill="#475569" />
    <text x="24" y="32" fill="#FFFFFF" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="700" text-anchor="middle">R</text>
    <text x="68" y="33" fill="#1E293B" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="24" font-weight="700" letter-spacing="1.5">RAHUL YADAV</text>
  </g>

  <!-- QR Code Matrix -->
  <g transform="translate(55, 135)">
    <svg width="430" height="430" viewBox="0 0 45 45">
      <path fill="#111827" d="M0 0h47v47H0z" />
    </svg>
    
    <!-- Central Google Pay Logo Badge -->
    <circle cx="215" cy="215" r="38" fill="#FFFFFF" stroke="#F1F5F9" stroke-width="2" />
    
    <!-- Google Pay G Emblem Icon -->
    <g transform="translate(215, 215) scale(0.6)">
      <!-- Blue Top-Left Loop -->
      <path d="M-18,-8 C-18,-18 -10,-26 2,-26 C12,-26 20,-18 20,-8 C20,-2 14,4 8,8 L-6,8 C-14,8 -18,2 -18,-8 Z" fill="#4285F4" />
      <!-- Green Bottom-Right Loop -->
      <path d="M10,2 C18,2 26,10 26,20 C26,30 18,38 8,38 C-2,38 -10,30 -10,20 C-10,14 -4,8 2,4 Z" fill="#34A853" />
      <!-- Red Top Dot -->
      <circle cx="-2" cy="-12" r="10" fill="#EA4335" />
      <!-- Yellow Bottom Dot -->
      <circle cx="14" cy="12" r="10" fill="#FBBC04" />
    </g>
  </g>

  <!-- UPI ID Under QR -->
  <text x="270" y="635" fill="#1E293B" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="20" font-weight="600" text-anchor="middle">UPI ID: yadav329337-1@okhdfcbank</text>

  <!-- Bottom Helper Prompt -->
  <text x="270" y="740" fill="#64748B" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="18" font-weight="500" text-anchor="middle">Scan to pay with any UPI app</text>
</svg>